# ENTSO-E API token (replace with your token in src/config.yaml)
entsoe:
  api_key: "YOUR_ENTSOE_API_KEY_HERE"
  # preferred country code for demo (ISO/ENTSO-E bidding zone id)
  default_area: DE_LU
  # optional: list of areas to ingest/forecast (exclude GB/IE/NI for now)
  areas:
    - DE_LU
    - FR
    - IT
    - ES
    - NL
    - BE
    - PT
    - CH
    - AT
    - PL
    - CZ
    - SK
    - HU
    - RO
    - BG
    - SI
    - HR
    - GR
    - DK1
    - DK2
    - FI
    - SE1
    - SE2
    - SE3
    - SE4
    - NO1
    - NO2
    - NO3
    - NO4
    - NO5
    - LT
    - LV
    - EE

# Paths for price/weather files (per area)
paths:
  price_template: "data/{area}/day_ahead_real.parquet"   # fallback to CSV if parquet missing
  weather_template: "data/weather/{area}_weather.csv"
  demand_template: "data/{area}/load_real.parquet"       # fallback to CSV if parquet missing

# Data timeframe for demo (days of history to fetch)
data:
  history_days: 90
  forecast_horizon_days: 7

# Feature toggles for pipelines
features:
  use_weather: true
  enable_quantile_models: true

# Model parameters for reproducible training
model:
  cv_splits: 3
  num_boost_round: 200
  lgbm_params:
    objective: regression
    metric: rmse
    verbosity: -1
    num_leaves: 31

# Artifact/versioning output
artifacts:
  dir: "artifacts"
